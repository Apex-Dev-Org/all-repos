# Public app URL.
NEXT_PUBLIC_APP_URL=https://your-web-domain

# Leave blank to use the Next.js /api/backend proxy.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_AUTH_TOKEN=

# Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Backend proxy target for /api/backend/*.
BACKEND_URL=https://your-backend-service-url
API_V1_PREFIX=/api/v1

# Dodo Payments.
DODO_PAYMENTS_API_KEY=sk_live_or_test_key
DODO_WEBHOOK_SECRET=whsec_live_or_test_secret
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PAYMENTS_RETURN_URL=https://your-web-domain/settings
DODO_CUSTOMER_PORTAL_RETURN_URL=https://your-web-domain/settings

# Dodo product IDs for the selected DODO_PAYMENTS_ENVIRONMENT.
NEXT_PUBLIC_DODO_PRO_MONTH_ID=
NEXT_PUBLIC_DODO_PRO_YEAR_ID=
NEXT_PUBLIC_DODO_ULTRA_MONTH_ID=
NEXT_PUBLIC_DODO_ULTRA_YEAR_ID=
