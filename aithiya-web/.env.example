# Browser-visible API base (defaults to /api/backend)
NEXT_PUBLIC_API_BASE_URL=

# Optional dev-only: send a fixed Bearer without Supabase (omit in production)
NEXT_PUBLIC_AUTH_TOKEN=

# Supabase (server-side Next routes: auth and billing persistence)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dodo Payments (server-side)
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/settings
DODO_CUSTOMER_PORTAL_RETURN_URL=http://localhost:3000/settings
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Dodo Payments product IDs (public)
NEXT_PUBLIC_DODO_PRO_MONTH_ID=
NEXT_PUBLIC_DODO_PRO_YEAR_ID=
NEXT_PUBLIC_DODO_ULTRA_MONTH_ID=
NEXT_PUBLIC_DODO_ULTRA_YEAR_ID=

# Backend origin for /api/backend proxy
BACKEND_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

# Used by forgot-password redirect (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000
