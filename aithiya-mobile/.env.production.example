# Public Supabase values for the mobile app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Keep this in Supabase Auth redirect URLs.
AUTH_REDIRECT_URL=aithiya://auth-callback

# Production backend root URL, without /api/v1.
API_BASE_URL=https://your-backend-service-url
API_V1_PREFIX=/api/v1

# Prefer moving this behind the backend before public release.
ELEVENLABS_API_KEY=
