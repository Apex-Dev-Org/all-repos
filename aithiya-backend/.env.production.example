ENV=production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=https://your-web-domain

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_AUDIENCE=authenticated

GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_OUTPUT_DIM=768

RAG_TOP_K=8
RAG_ONLY_IN_EFFECT=true
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_CHARS=480
EMBED_BATCH_SIZE=16
EMBED_BATCH_DELAY_S=13
EMBED_QUOTA_RETRY_MAX=2
EMBED_QUOTA_RETRY_WAIT_S=60

TEMP_DIR=/tmp/aithiya
MAX_UPLOAD_MB=25
MAX_CHAT_TOTAL_MB=50

RATE_LIMIT_CHAT_PER_MINUTE=60
RATE_LIMIT_INGEST_PER_MINUTE=10
